<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Every one of these is confirmed to be flagged by Qodana's own
       vulnerability service; they appear in backend.log as
       "<name> <version> contains vulnerabilities". -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="9.0.1" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.0" />
    <PackageReference Include="System.Net.Http" Version="4.3.0" />
    <PackageReference Include="SSH.NET" Version="2024.0.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.1" />
  </ItemGroup>

  <!-- Built locally by tools/Make-UnknownPackage.ps1 and served from the
       ./localfeed folder source. Qodana's security feed cannot resolve this
       id, so it never caches and is re-fetched on every pass - including the
       report-time pass on the dispatcher thread. See NuGet.config. -->
  <ItemGroup>
    <PackageReference Include="Qvuln.Unlisted.Probe" Version="1.0.0" />
  </ItemGroup>

</Project>
