<?xml version="1.0" encoding="utf-8"?>
<!--
  A LOCAL FOLDER source, not a private feed.

  The reproduction needs one package identity that Qodana's security metadata
  service cannot resolve. Such a package returns no metadata, so nothing is
  cached, so it is re-fetched on every pass - including the report-time pass
  that runs on the dispatcher thread, which is the fetch that throws.

  This deliberately needs NO credentials and NO server. Anyone who clones the
  repository can run it. That distinction matters: QD-12585 was dismissed
  partly because the reporter had an authenticated private feed, and this
  report must not be dismissible on the same grounds.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="localfeed" value="./localfeed" />
  </packageSources>
</configuration>
